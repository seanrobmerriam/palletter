---
import Layout from "../layouts/Layout.astro";
import Generator from "../components/Generator.svelte";
import ThemeToggle from "../components/ThemeToggle.svelte";
---

<Layout>
  <div class="mx-auto w-full max-w-7xl px-4 pb-8">
    <header class="flex items-start justify-between gap-4 pt-8 pb-6">
      <div class="grid gap-1">
        <h1 class="text-2xl font-semibold">Palletter</h1>
        <p class="text-on-surface-variant">Color palettes and copy-ready tokens, generated by your own agent.</p>
      </div>
      <ThemeToggle client:load />
    </header>
    <main>
      <Generator client:load />
    </main>
  </div>
</Layout>
