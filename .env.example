# Palletter agent settings. Copy this file to .env and fill in what you need.
# See "Connect your agent" in the README.

# The default agent: claude, minimax, or custom.
# PALLETTER_AGENT=claude

# MiniMax, through the Claude Code ACP adapter.
# MINIMAX_API_KEY=
# PALLETTER_MINIMAX_MODEL=MiniMax-M3.1-Flash
# PALLETTER_MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# Any other ACP agent.
# PALLETTER_AGENT_COMMAND="gemini --experimental-acp"

# How long to wait for the agent's reply, in milliseconds.
# PALLETTER_AGENT_TIMEOUT_MS=180000
